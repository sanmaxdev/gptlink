GPTLINK_HOST=127.0.0.1
GPTLINK_PORT=8787
GPTLINK_DATA_DIR=/var/lib/gptlink
CODEX_HOME=/home/gptlink/.codex
GPTLINK_PUBLIC_BASE_URL=http://127.0.0.1:8787
# Colon-separated server-local roots that remote MCP tools may read/write.
GPTLINK_MCP_ALLOWED_ROOTS=/var/lib/gptlink/images
# Required only for signed webhook delivery. Generate a random value of 32+ characters.
GPTLINK_WEBHOOK_SECRET=
# Required for webhooks: comma-separated exact callback host allowlist.
GPTLINK_WEBHOOK_ALLOWED_HOSTS=
GPTLINK_WEBHOOK_ALLOW_PRIVATE=false
GPTLINK_WEBHOOK_MAX_ATTEMPTS=6
GPTLINK_JOB_WORKERS=1
